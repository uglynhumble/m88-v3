# ─── М88 — базовые настройки Apache / LiteSpeed ───────────────────────────────
# Если хостинг на nginx без Apache — попросите поддержку перенести правила
# в конфиг сервера (или см. nginx.conf.example рядом с этим файлом).

DirectoryIndex index.html index.php

# ─── HTTPS и единственная версия домена ──────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Всегда https
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # www → без www (закомментируйте, если нужен обратный вариант)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # /press-formy → /press-formy/ (слэш на конце, чтобы не ломались пути к assets)
  RewriteRule ^press-formy$ /press-formy/ [R=301,L]
</IfModule>

# ─── Страница ошибки ─────────────────────────────────────────────────────────
ErrorDocument 404 /404.html

# ─── Закрываем служебное ─────────────────────────────────────────────────────
<FilesMatch "^(config\.php|README\.md|nginx\.conf\.example|\.htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^storage/ - [F,L]
</IfModule>

Options -Indexes

# ─── Сжатие ──────────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# ─── Кэш статики ─────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png            "access plus 6 months"
  ExpiresByType image/jpeg           "access plus 6 months"
  ExpiresByType image/svg+xml        "access plus 6 months"
  ExpiresByType text/css             "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html            "access plus 0 seconds"
</IfModule>

# ─── Безопасность ────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

AddDefaultCharset UTF-8

# ─── Лимиты загрузки ─────────────────────────────────────────────────────────
# Нужны, чтобы к заявке проходили вложения до 20 МБ.
# ВНИМАНИЕ: строки ниже работают только на Apache + mod_php. На PHP-FPM,
# LiteSpeed и большинстве современных хостингов они дают ошибку 500 —
# там те же значения задаются в панели хостинга или в .user.ini / php.ini.
#
# <IfModule mod_php.c>
#   php_value upload_max_filesize 21M
#   php_value post_max_size 25M
#   php_value max_file_uploads 10
#   php_value max_execution_time 120
# </IfModule>
